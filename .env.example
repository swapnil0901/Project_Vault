# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/projectvault?retryWrites=true&w=majority&appName=ProjectVault

# Application settings
PORT=5000
# Comma-separated frontend origins allowed by the API.
CLIENT_URL=http://localhost:5173
# Leave empty when the frontend and API share one deployed origin; use the public API URL for a separate backend.
VITE_API_URL=http://localhost:5000
JWT_SECRET=replace-with-a-long-random-secret
# Optional server-side integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GITHUB_TOKEN=
